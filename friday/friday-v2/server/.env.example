# Friday Server — Environment Variables
# Copy this file to .env and fill in your values.
# The .env file is gitignored and will never be committed.

# Required: Your Anthropic API key for Claude evaluations
# Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=your-key-here

# Optional: Path to your career-ops folder (defaults to ~/Documents/career-ops)
# CAREER_OPS_PATH=C:\Users\YourName\Documents\career-ops
